<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TecnoGas Hogar - Portal Interno</title>
    <link rel="stylesheet" href="https://jsdelivr.netbootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">🔥 TecnoGas Hogar</a>
                <div class="navbar-nav d-flex flex-row">
                    <a class="nav-link text-white me-3" href="/Solicitud/Registrar">➕ Nueva Solicitud</a>
                    <a class="nav-link text-white" href="/Solicitud">📋 Ver Lista</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top text-muted mt-5 py-3 bg-white text-center">
        <div class="container">
            &copy; 2026 - TecnoGas Hogar - Evaluación Continua
        </div>
    </footer>
    <script src="https://jsdelivr.netbootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
