@model TecnoGasHogar.Models.SolicitudServicio

@{
    Layout = null; // Rompe la dependencia del Layout roto
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrar Solicitud - TecnoGas Hogar</title>
    <!-- Enlace directo y forzado de Bootstrap -->
    <link rel="stylesheet" href="https://jsdelivr.net">
</head>
<body class="bg-light">
    <!-- Barra de Navegación manual con estilos reales -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">🔥 TecnoGas Hogar</a>
            <div class="navbar-nav">
                <a class="nav-link text-white me-3" href="/Solicitud/Registrar">➕ Nueva Solicitud</a>
                <a class="nav-link text-white" href="/Solicitud">📋 Ver Lista</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3">
                        <h3 class="card-title mb-0 fs-4">🛠️ Portal Interno - Registrar Solicitud</h3>
                    </div>
                    <div class="card-body p-4">

                        @if (TempData["MensajeExito"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @TempData["MensajeExito"]
                            </div>
                        }

                        <form action="/Solicitud/Registrar" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="Cliente" class="form-label fw-semibold">Nombre del Cliente</label>
                                <input type="text" id="Cliente" name="Cliente" class="form-control" required placeholder="Ej. Juan Pérez" />
                            </div>

                            <div class="mb-3">
                                <label for="Telefono" class="form-label fw-semibold">Teléfono / WhatsApp</label>
                                <input type="text" id="Telefono" name="Telefono" class="form-control" required placeholder="Ej. 987654321" />
                            </div>

                            <div class="mb-3">
                                <label for="Distrito" class="form-label fw-semibold">Distrito</label>
                                <input type="text" id="Distrito" name="Distrito" class="form-control" required placeholder="Ej. Los Olivos" />
                            </div>

                            <div class="mb-3">
                                <label for="TipoServicio" class="form-label fw-semibold">Tipo de Servicio</label>
                                <select id="TipoServicio" name="TipoServicio" class="form-select" required>
                                    <option value="">-- Seleccione una opción --</option>
                                    <option value="Instalación">Instalación</option>
                                    <option value="Mantenimiento">Mantenimiento</option>
                                    <option value="Revisión">Revisión</option>
                                    <option value="Fuga">Fuga</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="Descripcion" class="form-label fw-semibold">Descripción del Problema (Opcional)</label>
                                <textarea id="Descripcion" name="Descripcion" class="form-control" rows="3" placeholder="Detalles del artefacto a gas..."></textarea>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-success btn-lg fs-6 shadow-sm">💾 Guardar Solicitud de Servicio</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://jsdelivr.net"></script>
</body>
</html>
