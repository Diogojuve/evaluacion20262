@model IEnumerable<TecnoGasHogar.Models.SolicitudServicio>

@{
    Layout = null; // Rompe la dependencia del Layout roto
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Historial de Solicitudes - TecnoGas Hogar</title>
    <!-- Enlace directo y forzado de Bootstrap -->
    <link rel="stylesheet" href="https://jsdelivr.net">
</head>
<body class="bg-light">
    <!-- Barra de Navegación manual con estilos reales -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">🔥 TecnoGas Hogar</a>
            <div class="navbar-nav">
                <a class="nav-link text-white me-3" href="/Solicitud/Registrar">➕ Nueva Solicitud</a>
                <a class="nav-link text-white" href="/Solicitud">📋 Ver Lista</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 mb-0 text-dark fw-bold">📋 Historial de Solicitudes - TecnoGas Hogar</h2>
            <a href="/Solicitud/Registrar" class="btn btn-primary shadow-sm">➕ Registrar Nueva Solicitud</a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Cliente</th>
                                <th>Teléfono</th>
                                <th>Distrito</th>
                                <th>Tipo de Servicio</th>
                                <th>Descripción</th>
                                <th class="pe-3">Fecha de Registro</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">No hay ninguna solicitud registrada en el sistema.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-3">@item.Id</td>
                                        <td class="fw-bold">@item.Cliente</td>
                                        <td>@item.Telefono</td>
                                        <td><span class="badge bg-secondary">@item.Distrito</span></td>
                                        <td>
                                            @{
                                                var badgeClass = item.TipoServicio switch
                                                {
                                                    "Fuga" => "bg-danger",
                                                    "Instalación" => "bg-success",
                                                    "Mantenimiento" => "bg-info text-dark",
                                                    _ => "bg-warning text-dark"
                                                };
                                            }
                                            <span class="badge @badgeClass">@item.TipoServicio</span>
                                        </td>
                                        <td>@(string.IsNullOrEmpty(item.Descripcion) ? "-" : item.Descripcion)</td>
                                        <td class="pe-3 text-muted" style="font-size: 0.9rem;">@item.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://jsdelivr.net"></script>
</body>
</html>
