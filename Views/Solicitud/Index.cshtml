@model IEnumerable<TecnoGasHogar.Models.SolicitudServicio>

@{
    ViewData["Title"] = "Listado de Solicitudes de Servicio";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📋 Historial de Solicitudes - TecnoGas Hogar</h2>
        <a asp-action="Registrar" class="btn btn-primary">➕ Registrar Nueva Solicitud</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Cliente</th>
                            <th>Teléfono</th>
                            <th>Distrito</th>
                            <th>Tipo de Servicio</th>
                            <th>Descripción</th>
                            <th>Fecha de Registro</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No hay ninguna solicitud registrada en el sistema.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td class="fw-bold">@item.Cliente</td>
                                    <td>@item.Telefono</td>
                                    <td><span class="badge bg-secondary">@item.Distrito</span></td>
                                    <td>
                                        @{
                                            var badgeClass = item.TipoServicio switch
                                            {
                                                "Fuga" => "bg-danger",
                                                "Instalación" => "bg-success",
                                                "Mantenimiento" => "bg-info text-dark",
                                                _ => "bg-warning text-dark"
                                            };
                                        }
                                        <span class="badge @badgeClass">@item.TipoServicio</span>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(item.Descripcion) ? "-" : item.Descripcion)</td>
                                    <td>@item.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
